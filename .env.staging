ENVIRONMENT=staging
DEBUG=false

# PostgreSQL Staging
POSTGRES_HOST=staging-db.internal
POSTGRES_PORT=5432
POSTGRES_USER=mallkitrace_staging
POSTGRES_PASSWORD=staging_secure_password
POSTGRES_DB=mallkitrace_staging

# AWS Staging
AWS_REGION=us-east-1
TIMESTREAM_DATABASE=SensorDataStaging
TIMESTREAM_TABLE=MeasurementsStaging

# JWT Staging
JWT_SECRET_KEY=staging-secret-key-change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=45

# CORS Staging
CORS_ORIGINS=https://staging.tarpuqkuna.lat

# Logging
LOG_LEVEL=INFO

# Sensor API
SENSOR_API_KEY=staging-sensor-key