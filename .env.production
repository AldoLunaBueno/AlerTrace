ENVIRONMENT=production
DEBUG=false

# PostgreSQL Production (RDS)
POSTGRES_HOST=sachatrace-prod.cluster-xyz.us-east-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_USER=sachatrace_prod
POSTGRES_PASSWORD=${POSTGRES_PASSWORD_SECRET}
POSTGRES_DB=sachatrace_production

# AWS Production
AWS_REGION=us-east-1
TIMESTREAM_DATABASE=SensorDataProd
TIMESTREAM_TABLE=MeasurementsProd

# JWT Production
JWT_SECRET_KEY=${JWT_SECRET_FROM_SECRETS_MANAGER}
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Production
CORS_ORIGINS=https://tarpuqkuna.lat

# Logging
LOG_LEVEL=WARNING

# Sensor API
SENSOR_API_KEY=${SENSOR_API_KEY_FROM_SECRETS}