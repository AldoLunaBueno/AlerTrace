# Environment Configuration# Example .env (do not commit real secrets)

ENVIRONMENT=development

ENVIRONMENT=default

# Database ConfigurationDEBUG=false

POSTGRES_HOST=localhostLOG_LEVEL=INFO

POSTGRES_PORT=5432

POSTGRES_USER=postgres# PostgreSQL (RDS)

POSTGRES_PASSWORD=postgresPOSTGRES_HOST=your-rds-endpoint.rds.amazonaws.com

POSTGRES_DB=sachatrace_devPOSTGRES_PORT=5432

POSTGRES_USER=postgres

# Redis ConfigurationPOSTGRES_PASSWORD=change_me

REDIS_HOST=localhostPOSTGRES_DB=postgres

REDIS_PORT=6379

REDIS_PASSWORD=# AWS / Timestream

AWS_REGION=us-east-1

# AWS ConfigurationTIMESTREAM_DATABASE=SensorData

AWS_REGION=us-east-1TIMESTREAM_TABLE=Measurements

AWS_ACCESS_KEY_ID=your_access_key

AWS_SECRET_ACCESS_KEY=your_secret_key# JWT

JWT_SECRET_KEY=change_me

# Timestream ConfigurationJWT_ACCESS_TOKEN_EXPIRE_MINUTES=45

TIMESTREAM_DATABASE_NAME=SachaTrace

TIMESTREAM_TABLE_NAME=SensorData# CORS (comma-separated)

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Lambda Configuration

SENSOR_DATA_PROCESSOR_ARN=arn:aws:lambda:us-east-1:123456789012:function:sensor-data-processor# Sensor API

DATA_AGGREGATOR_ARN=arn:aws:lambda:us-east-1:123456789012:function:data-aggregatorSENSOR_API_KEY=change_me
ALERTS_ENGINE_ARN=arn:aws:lambda:us-east-1:123456789012:function:alerts-engine

# API Configuration
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-change-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30